[Unit]
Description=Friday Wearable Voice Detection Daemon
After=bluetooth.target sound.target
Wants=bluetooth.target

[Service]
Type=simple
User=avaneesh
WorkingDirectory=/home/avaneesh
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/avaneesh/friday_env/bin/python3 /home/avaneesh/wearable_daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
